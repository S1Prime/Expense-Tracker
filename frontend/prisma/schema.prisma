// Prisma schema for Expense Tracker
// Supports SQLite (default for development) and PostgreSQL (production/docker)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  avatarUrl String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  expenses  Expense[]
  budgets   Budget[]
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  icon        String?   // e.g. "coffee", "shopping-bag", "car"
  color       String?   // hex color code, e.g. "#10B981"
  budgetLimit Float?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  expenses    Expense[]
  budgets     Budget[]
}

model Expense {
  id            String    @id @default(cuid())
  title         String
  amount        Float
  currency      String    @default("USD")
  date          DateTime  @default(now())
  notes         String?
  paymentMethod String    @default("CASH") // CASH, CREDIT_CARD, DEBIT_CARD, UPI, BANK_TRANSFER
  isRecurring   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  categoryId    String
  category      Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([categoryId])
}

model Budget {
  id          String    @id @default(cuid())
  month       Int       // 1 - 12
  year        Int       // e.g. 2026
  amount      Float
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([month, year, categoryId, userId])
}
