# ==========================================
# EXPENSE TRACKER - ENVIRONMENT CONFIGURATION
# ==========================================

# Database Connection (Default: SQLite for zero-config local dev)
# To use PostgreSQL, replace with your connection string:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/expense_tracker?schema=public"
DATABASE_URL="file:./dev.db"

# Application Settings
NEXT_PUBLIC_APP_NAME="Expense Tracker"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_CURRENCY="USD"
NEXT_PUBLIC_ENABLE_ANALYTICS="true"

# NextAuth / Auth Configuration (for future authentication integration)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-secure-random-32-byte-secret"
